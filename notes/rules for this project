2. db.php has a function function sanitize_data(mixed $data): mixed
{
    if (is_array($data)) {
        return array_map('sanitize_data', $data);
    }

    if (!is_string($data)) {
        return $data;
    }

    return html_entity_decode(
        strip_tags($data),
        ENT_QUOTES | ENT_HTML5,
        'UTF-8'
    );
}
used for sanitizing incoming and outgoing data. 
